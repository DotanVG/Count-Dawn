{
  "name": "count-dawn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Count Dawn — a reverse horde survival game: a vampire hunts waves of human hunters, collects blood, defeats their leader, and races back to his coffin before sunrise.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "node --experimental-transform-types --test \"tests/*.test.mjs\""
  },
  "keywords": [
    "phaser",
    "game",
    "top-down",
    "vampire",
    "typescript",
    "vite",
    "game-jam"
  ],
  "author": "Dotan, Romi, Noam, Abed",
  "license": "MIT",
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  }
}
